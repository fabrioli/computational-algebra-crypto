cf.anillo_fp_x.divmod_fast = fp_x_divmod

# input: fp -> cuerpo_fp
# input: g -> elemento del grupo multiplicativo fp* de orden n (objeto opaco)
# input: k >= 0 tal que n = 2**k divide a p-1
# input: a -> tupla de longitud n de elementos de fp
# output: DFT_{n,g}(a) -> tupla de longitud n de elementos de fp
# utilizar el algoritmo de Cooley-Tuckey
def fp_fft(fp, g, k, a):
    n = len(a)
    if n == 1:
        return a
    a_par = a[0::2]
    a_impar = a[1::2]
    
    g2 = fp.mult(g, g)
    
    y_par = fp_fft(fp, g2, k-1, a_par)
    y_impar  = fp_fft(fp, g2, k-1, a_impar)
    
    res = [None] * n
    w = fp.uno()
    n_med = n // 2
    
    for j in range(n_med):
        val_par = y_par[j]
        val_impar = y_impar[j]
        term = fp.mult(w, val_impar)
        res[j] = fp.suma(val_par, term)
        res[j + n_med] = fp.suma(val_par, fp.inv_adit(term))
        w = fp.mult(w, g)
        
    return tuple(res)


# input: fp -> cuerpo_fp
# input: g -> elemento del grupo multiplicativo fp* de orden n (objeto opaco)
# input: k >= 0 tal que n = 2**k divide a p-1
# input: a -> tupla de longitud n de elementos de fp
# output: IDFT_{n,g}(a) -> tupla de longitud n de elementos de fp
# recordar que IDFT_{n,g} = n^(-1) * DFT_{n,g^(-1)}
def fp_ifft(fp, g, k, a):
    n = len(a)

    g_inv = fp.inv_mult(g)
    
    dft_inv = fp_fft(fp, g_inv, k, a)

    n_elem = fp.elem_de_int(n)
    inv_n = fp.inv_mult(n_elem)

    res = []
    for val in dft_inv:
        res.append(fp.mult(val, inv_n))
        
    return tuple(res)

