# input: fpx -> anillo_fp_x
# input: f -> polinomio (objeto opaco creado por fpx)
# input: g -> polinomio (objeto opaco creado por fpx)
# output: f*g calculado usando el método de Karatsuba
def fp_x_mult_karatsuba(fpx, f, g):
    n = min(f.deg, g.deg) 
    if n <= 20: return fpx.mult(f,g)
    N = max(f.deg,g.deg)+1
    k = N//2
    f_u = cf.Polinomio(fpx.fp, f.coef[k:], f.var)
    f_l = cf.Polinomio(fpx.fp, f.coef[:k], f.var)
    g_u = cf.Polinomio(fpx.fp, g.coef[k:], g.var)
    g_l = cf.Polinomio(fpx.fp, g.coef[:k], g.var)
    
    h_0 = fp_x_mult_karatsuba(fpx, f_l, g_l)
    h_1 = fp_x_mult_karatsuba(fpx, f_u, g_u)
    h_0_1 = fp_x_mult_karatsuba(fpx, f_l + f_u, g_l + g_u)
    
    term_mid = fpx.suma(h_0_1, fpx.inv_adit(h_1))
    term_mid = fpx.suma(term_mid, fpx.inv_adit(h_0))
    
    cero_fp = fpx.fp.cero()
    
    h_1_desp = cf.Polinomio(fpx.fp, [cero_fp]*(2*k) + h_1.coef, f.var)
    term_mid_desp = cf.Polinomio(fpx.fp, [cero_fp]*k + term_mid.coef, f.var)
    
    res_parcial = fpx.suma(h_1_desp, term_mid_desp)
    return fpx.suma(res_parcial, h_0)
    

# añadimos esta función a la clase (sin sobreescribir la que ya teníamos)
cf.anillo_fp_x.mult_fast = fp_x_mult_karatsuba

# input: fp -> cuerpo_fp
# input: n >= 1 (int)
# input: a -> tupla de longitud n de elementos de fp (primera columna de una
#    matriz de Toeplitz inferior T de nxn)
# input: b -> tupla de longitud n de elementos de fp (vector)
# output: T*b -> tupla de longitud n de elementos de fp (vector)
# se debe utilizar fp_x_mult_karatsuba internamente
def fp_toep_inf_vec(fp, n, a, b):
    fpx = cf.anillo_fp_x(fp)
    prod = fp_x_mult_karatsuba(fpx, fpx.elem_de_tuple(a), fpx.elem_de_tuple(b))
    res = []
    for i in range(n):
        if i <= prod.deg:
            res.append(prod.coef[i])
        else:
            res.append(fp.cero())
    return tuple(res)
# input: fp -> cuerpo_fp
# input: n >= 1 (int)
# input: a -> tupla de longitud n de elementos de fp (primera fila de una
#    matriz de Toeplitz superior T de nxn)
# input: b -> tupla de longitud n de elementos de fp (vector)
# output: T*b -> tupla de longitud n de elementos de fp (vector)
# se debe utilizar fp_x_mult_karatsuba internamente
def fp_toep_sup_vec(fp, n, a, b):
    fpx = cf.anillo_fp_x(fp)
    prod = fp_x_mult_karatsuba(fpx, fpx.elem_de_tuple(a), fpx.elem_de_tuple(b[::-1]))
    res = []
    for i in range(n):
        if i <= prod.deg:
            res.append(prod.coef[i])
